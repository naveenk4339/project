# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- LLM: claude | openai | gemini ---
LLM_PROVIDER=claude
# Leave blank to use the provider default (claude-opus-5 / gpt-5-mini / gemini-2.5-flash)
LLM_MODEL=

# --- Embeddings: openai | gemini | hash ---
# Anthropic has no embeddings endpoint, so pair Claude with OpenAI or Gemini embeddings.
# "hash" is an offline, keyword-only embedder for local smoke tests - not for real use.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
# Must match the model: text-embedding-3-small = 1536, gemini-embedding-001 = 768 (we request 768)
EMBEDDING_DIM=1536

# --- Provider keys (only the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Retrieval tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
